#   strat = 'clst'
# }
# filter for path
path_df <- path |>
filter(
# strategy == strat &
forager == for_num & level == lvl
) |>
add_row(
strategy = simul_results$strategy[1], forager = for_num, level = lvl,
nn_weight = simul_results$nn_weight[1],
ta_weight = simul_results$ta_weight[1], clst_weight = simul_results$clst_weight[1],
