labels = c('Cluster', 'Nearest neighbor', 'Players', 'Turning angle')
) +
labs(
x = 'time (s)',
y = 'game level',
title = 'performance',
subtitle = 'participants vs. simulations'
) +
proposal_theme()
# ridges to simulation
performance_and_rmi |>
mutate(
level = as.numeric(str_extract(level, '[0-9]+')),
strategy = 'participant'
) |>
bind_rows(simul_perf_and_rmi) |>
ggplot(aes(x = total_time, y = as.factor(level))) +
geom_density_ridges(aes(group = as.factor(strategy))) +
scale_x_continuous(n.breaks = 10) +
scale_alpha_manual(
'Strategy', values = c(.5, .5, .9, .5),
labels = c('Cluster', 'Nearest neighbor', 'Players',  'Turning angle')
) +
scale_color_manual(
'Strategy', values = c(clrs[1], clrs[6], clrs[2], clrs[4]),
labels = c('Cluster', 'Nearest neighbor', 'Players',  'Turning angle')
) +
scale_fill_manual(
'Strategy', values = c(clrs[1], clrs[6], clrs[2], clrs[4]),
labels = c('Cluster', 'Nearest neighbor', 'Players', 'Turning angle')
) +
labs(
x = 'time (s)',
y = 'game level',
title = 'performance',
subtitle = 'participants vs. simulations'
) +
proposal_theme()
