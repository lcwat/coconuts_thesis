p <- exp_df |>
ggplot() +
geom_path(
data = path_df, aes(x = x, y = y), linewidth = .2,
arrow = arrow(type = 'closed')
) +
geom_point(
aes(
x = x, y = y, size = as.factor(point_value), color = cos(turning_angle),
