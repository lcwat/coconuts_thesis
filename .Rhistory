mutate(
cos_ta = cos(turning_angle),
inv_dist = 1 / distance,
c_inv_dist = inv_dist - mean(inv_dist, na.rm = T),
c_cos_ta = cos_ta - mean(cos_ta, na.rm = T),
c_clst = neighbor_value - mean(neighbor_value, na.rm = T),
c_point_val = point_value - mean(point_value, na.rm = T)
)
