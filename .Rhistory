# data reading and cleaning
library(tidyverse)
# bayesian modeling, summary, and visualization
library(brms)
library(tidybayes)
library(marginaleffects)
# or load in file pre-cleaned and subsetted
nn_runs_expanded <- read_csv(
'data/simulation/expansion_cleaned/cleaned_10_nn_expanded_lvl_8.csv'
)
# see the formula
bf(
used ~ cinvdist * ccosta * cclst * cpv +
(cinvdist * ccosta * cclst * cpv | id) + (1 | colnum),
family = 'poisson',
data = nn_runs_expanded
)
# see the formula
bf(
used ~ c_inv_dist * c_cos_ta * c_clst * c_point_val +
(c_inv_dist * c_cos_ta * c_clst * c_point_val | id) + (1 | collection_num),
family = 'poisson',
data = nn_runs_expanded
)
# see the formula
bf(
used ~ c_inv_dist * c_cos_ta * c_clst * c_point_val +
(c_inv_dist * c_cos_ta * c_clst * c_point_val | id) + (1 | collection_num)
)
# see the formula
brms::bf(
used ~ c_inv_dist * c_cos_ta * c_clst * c_point_val +
(c_inv_dist * c_cos_ta * c_clst * c_point_val | id) + (1 | collection_num)
)
# see the formula
get_prior(
bf(used ~ c_inv_dist * c_cos_ta * c_clst * c_point_val +
(c_inv_dist * c_cos_ta * c_clst * c_point_val | id) + (1 | collection_num)),
prior = my_priors,
data = nn_runs_expanded
)
# priors
my_priors <- c(
prior_string('normal(0, 1)', class = 'b'),
prior('normal(10e6, 0)', class = 'sd', group = 'colnum')
)
# see the formula
get_prior(
bf(used ~ c_inv_dist * c_cos_ta * c_clst * c_point_val +
(c_inv_dist * c_cos_ta * c_clst * c_point_val | id) + (1 | collection_num)),
prior = my_priors,
data = nn_runs_expanded
)
# priors
my_priors <- c(
set_prior('normal(0, 1)', class = 'b'),
set_prior('normal(10e6, 0)', class = 'sd', group = 'colnum')
)
# see the formula
get_prior(
bf(used ~ c_inv_dist * c_cos_ta * c_clst * c_point_val +
(c_inv_dist * c_cos_ta * c_clst * c_point_val | id) + (1 | collection_num)),
prior = my_priors,
data = nn_runs_expanded
)
# priors
my_priors <- c(
set_prior('normal(0, 1)', class = 'b'),
set_prior('normal(10e6, 0)', class = 'sd', group = 'collection_num')
)
View(my_priors)
# see the formula
get_prior(
bf(used ~ c_inv_dist * c_cos_ta * c_clst * c_point_val +
(c_inv_dist * c_cos_ta * c_clst * c_point_val | id) + (1 | collection_num)),
prior = my_priors,
data = nn_runs_expanded
)
# full model
full_model <- bf(
used ~ c_inv_dist * c_cos_ta * c_clst * c_point_val +
(c_inv_dist * c_cos_ta * c_clst * c_point_val | id) + (1 | collection_num)
)
View(full_model)
# see the formula
get_prior(
full_model,
data = nn_runs_expanded
)
# full model
full_model <- bf(
used ~ c_inv_dist * c_cos_ta * c_clst * c_point_val +
(c_inv_dist * c_cos_ta * c_clst * c_point_val | id) + (1 | collection_num),
pfix = 10e6
)
View(full_model)
# run model
nn_model <- brm(
formula = full_model,
family = 'poisson',
priors = my_priors,
data = nn_runs_expanded
)
# full model
full_model <- bf(
used ~ c_inv_dist * c_cos_ta * c_clst * c_point_val +
(c_inv_dist * c_cos_ta * c_clst * c_point_val | id) + (1 | collection_num)
)
# run model
nn_model <- brm(
formula = full_model,
family = 'poisson',
priors = my_priors,
data = nn_runs_expanded
)
# drop nas
nn_runs_expanded <- nn_runs_expanded |>
drop_na()
summary(nn_runs_expanded)
# run model
nn_model <- brm(
formula = full_model,
family = 'poisson',
prior = my_priors,
data = nn_runs_expanded,
file = 'R/fits/initial_nn_full_model.rds'
)
get_prior(nn_model)
